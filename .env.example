# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Required for alerts (watches, inbox, push subscriptions). Nothing else uses it.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Robinhood Chain indexer ────────────────────────────────────────────
# Upstream API for tokens, portfolios, trades and quotes. Required — no provider
# host is hardcoded in the app. Supply the base URL and key for whichever
# Robinhood Chain indexer you have access to.
RH_INDEXER_BASE_URL=""
RH_INDEXER_API_KEY=""

# ── Robinhood Chain (chain id 4663) ────────────────────────────────────
# Optional server-side RPC override. Defaults to https://rpc.mainnet.chain.robinhood.com
# The browser wallet uses the same public endpoints via wagmi.
RH_RPC_URL=""

# ── App identity ───────────────────────────────────────────────────────
NEXT_PUBLIC_BAGSCAN_NAME="BagScan"
# Canonical public origin — drives metadata, Open Graph URLs, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL="https://bagscan.app"

# ── Alerts ─────────────────────────────────────────────────────────────
# Signs the wallet session cookie. Use a long random string (32+ chars).
ALERTS_SESSION_SECRET="change-me-to-a-long-random-string"
# Bearer token for GET/POST /api/alerts/cron
ALERTS_CRON_SECRET="change-me-cron-secret"
# Run the evaluator in-process. Leave unset on multi-instance hosting and use
# external cron against /api/alerts/cron instead, so runs don't overlap.
ENABLE_INTERNAL_ALERTS_RUNTIME="false"
ALERTS_RUNTIME_INTERVAL_MS="300000"

# ── Browser push (optional) ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@example.com"

# ── Telegram delivery (optional) ───────────────────────────────────────
# Bot token from @BotFather. Users paste their numeric chat id in alert settings.
TELEGRAM_BOT_TOKEN=""
