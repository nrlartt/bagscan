generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RhAlertKind {
  curve_progress
  graduation
  volume_spike
  price_move
  whale_trade
  system
}

enum RhAlertSeverity {
  info
  hot
  critical
}

/// One row per wallet that has signed in to alerts.
model RhSubscriber {
  wallet          String   @id // lowercase 0x address
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @updatedAt
  inAppEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(false)
  telegramEnabled Boolean  @default(false)
  telegramChatId  String?

  watches       RhWatch[]
  notifications RhAlertNotification[]
  pushSubs      RhPushSubscription[]
}

/// A token a wallet is watching, plus the rules that fire for it.
model RhWatch {
  id            String   @id @default(cuid())
  wallet        String
  tokenAddress  String // lowercase
  symbol        String?
  curveEnabled  Boolean  @default(true)
  gradEnabled   Boolean  @default(true)
  volumeEnabled Boolean  @default(true)
  /// Fire when |price change| since last evaluation exceeds this percentage.
  priceMovePct  Float?   @default(25)
  /// Fire when a single trade moves at least this much ETH.
  whaleTradeEth Float?   @default(0.25)
  createdAt     DateTime @default(now())

  subscriber RhSubscriber @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@unique([wallet, tokenAddress])
  @@index([tokenAddress])
}

/// Last observed on-chain state per token — the baseline every rule diffs against.
model RhTokenState {
  tokenAddress       String   @id // lowercase
  symbol             String?
  name               String?
  image              String?
  migrated           Boolean  @default(false)
  bondingProgressPct Float?
  priceEth           Float?
  volumeEth7d        Float?
  lastTradeAt        DateTime?
  /// Highest curve threshold already alerted on, so each band fires once.
  lastCurveBand      Int?
  updatedAt          DateTime @updatedAt
}

model RhAlertNotification {
  id           String          @id @default(cuid())
  wallet       String
  tokenAddress String
  kind         RhAlertKind
  severity     RhAlertSeverity @default(info)
  title        String
  body         String
  valueLabel   String?
  readAt       DateTime?
  createdAt    DateTime        @default(now())

  subscriber RhSubscriber @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet, createdAt])
  @@index([wallet, readAt])
}

model RhPushSubscription {
  endpoint  String   @id
  wallet    String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  subscriber RhSubscriber @relation(fields: [wallet], references: [wallet], onDelete: Cascade)

  @@index([wallet])
}

/// Short-lived nonce for wallet sign-in.
model RhAuthChallenge {
  nonce     String   @id
  wallet    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
